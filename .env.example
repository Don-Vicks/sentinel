# Solami Yellowstone gRPC (read by Vortex's Geyser client)
YELLOWSTONE_ENDPOINT=https://grpc.solami.dev
YELLOWSTONE_TOKEN=your-solami-api-key

# Solami RPC, used to label account owners in transaction traces
SOLANA_RPC_URL=https://rpc.solami.dev/sol?api_key=your-solami-api-key

# Solami Blur (USD prices). Needs the DataApi permission; defaults to YELLOWSTONE_TOKEN.
# BLUR_API_KEY=your-solami-api-key

# Solami Mirage: failover when gRPC can't connect (the same frames over a WebSocket).
# Create a subscription in the Solami dashboard and use a key that can only stream.
# MIRAGE_STREAM_URL=wss://ws.solami.dev/mirage/stream/YOUR_SUBSCRIPTION_ID?api_key=your-stream-only-key
# SENTINEL_TRANSPORT=mirage   # use Mirage as the primary instead

# Programs to monitor on startup (comma separated). More can be added in the UI.
SENTINEL_PROGRAMS=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

SENTINEL_PORT=8080
SENTINEL_DB=sentinel.db
# Base URL used for links in webhook payloads
SENTINEL_PUBLIC_URL=http://localhost:8080
